{
  "expo": {
    "name": "quick-capture",
    "slug": "quick-capture",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quickcapture",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Quick Capture uses the camera to photograph handwritten notes and turn them into todos.",
        "NSPhotoLibraryUsageDescription": "Quick Capture lets you pick note photos from your library to extract todos.",
        "NSMicrophoneUsageDescription": "Quick Capture uses the microphone to record voice notes and turn them into todos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "quickcapture"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Quick Capture uses the camera to photograph handwritten notes and turn them into todos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Quick Capture lets you pick note photos from your library to extract todos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Quick Capture uses the microphone to record voice notes and turn them into todos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "voice",
              "title": "Record voice",
              "subtitle": "Speak todos to capture",
              "icon": "symbol:mic.fill",
              "params": { "href": "/voice-record" }
            },
            {
              "id": "camera",
              "title": "Scan note",
              "subtitle": "Photo to todos",
              "icon": "symbol:camera.fill",
              "params": { "href": "/capture" }
            },
            {
              "id": "add-todo",
              "title": "Add todo",
              "subtitle": "Quick manual entry",
              "icon": "symbol:plus.circle.fill",
              "params": { "href": "/add-todo" }
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

    "@quick-capture/shared": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.5",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.8.3",
    "jose": "^6.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@quick-capture/typescript-config": "*",
    "@types/node": "^22.15.32",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3"

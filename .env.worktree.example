# Generated by `npm run worktree:bootstrap` — copy is gitignored as `.env.worktree`.
# Do not use in the main checkout (use root `.env` + `npm run docker:dev`).

WORKTREE_SLUG=feat-chat
COMPOSE_PROJECT_NAME=qc-feat-chat

API_PORT=3010
WEB_PORT=3011
WHISPER_PORT=3012
PORT=3010

# Branch-matched Neon values (must all come from the same branch)
DATABASE_URL=
NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
NEXT_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_NEON_AUTH_URL=

# Browser / mobile clients for this worktree instance
NEXT_PUBLIC_API_URL=http://localhost:3010
EXPO_PUBLIC_API_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3011,https://localhost:3011,http://localhost:8081

# Optional Portless URLs (bootstrap may set these instead):
# NEXT_PUBLIC_API_URL=https://api.feat-chat.quick-capture.localhost
# CORS_ORIGINS=https://feat-chat.quick-capture.localhost,...

TRANSCRIPTION_PROVIDER=whisper-cpp
WHISPER_CPP_BASE_URL=http://whisper:8080
WHISPER_CPP_INFERENCE_PATH=/inference

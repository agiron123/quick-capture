# --- API (server-only; never EXPO_PUBLIC) ---
PORT=3000
CAPTURE_STORAGE_DIR=
CAPTURE_STORAGE_PROVIDER=local
CAPTURE_STORAGE_ENDPOINT=
CAPTURE_STORAGE_BUCKET=
CAPTURE_STORAGE_ACCESS_KEY_ID=
CAPTURE_STORAGE_SECRET_ACCESS_KEY=
CAPTURE_STORAGE_REGION=auto
AI_PROVIDER=openai
OPENAI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
MINIMAX_CHAT_MODEL=MiniMax-M2.5
TRANSCRIPTION_PROVIDER=openai
# Local voice transcription via whisper.cpp (no OPENAI_API_KEY for STT):
# TRANSCRIPTION_PROVIDER=whisper-cpp
WHISPER_CPP_BASE_URL=http://127.0.0.1:8080
WHISPER_CPP_INFERENCE_PATH=/inference

# --- Neon (Phase 3) ---
# Use branch-matched values: DATABASE_URL and NEON_AUTH_* must come from the same Neon branch.
DATABASE_URL=
NEON_AUTH_URL=
CORS_ORIGINS=http://localhost:3001,https://localhost:3001,http://localhost:8081

# Push — Expo (mobile)
EXPO_ACCESS_TOKEN=

# Push — Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
REMINDER_POLL_INTERVAL_MS=60000

# Chat agent (MiniMax)
CHAT_MAX_HISTORY_MESSAGES=40
CHAT_RATE_LIMIT_PER_HOUR=30

# --- Web (Next.js) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_USE_MOCK_AI=true
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_USE_MOCK_AI=true
EXPO_PUBLIC_NEON_AUTH_URL=
